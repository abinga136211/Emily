NODE_ENV=development
HOST=0.0.0.0
PORT=3001
# SQLite path (relative to server/ or absolute, e.g. /var/lib/skmc/app.db)
DB_PATH=./data/app.db
# Vue dist folder (relative to server/ or absolute). Default: ../dist
# DIST_PATH=../dist
TRUST_PROXY=1
# Use * in dev; set false (same-origin) or a comma-separated allowlist in production
CORS_ORIGIN=*
BODY_LIMIT=32kb
# Required for /admin login and admin APIs — change before production
ADMIN_PASSWORD=change-me
ADMIN_SECRET=replace-with-a-long-random-string
ADMIN_TOKEN_TTL_HOURS=24
